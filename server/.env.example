PORT=4000
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=adhub

# --- Meta (Facebook) Marketing API -------------------------------------------
# Leave META_ACCESS_TOKEN empty to keep using the mock Facebook adapter.
# If the section is incomplete, the server warns and also falls back to the mock.
# Never commit real values: server/.env is git-ignored.

# Token with ads_management, ads_read, pages_show_list, pages_read_engagement
# (Graph API Explorer → Generate Access Token → extend to ~60 days)
META_ACCESS_TOKEN=
# App Dashboard → App settings → Basic → App secret (signs requests via appsecret_proof)
META_APP_SECRET=
# Ads Manager account id, with or without the act_ prefix (e.g. 1234567890 or act_1234567890)
META_AD_ACCOUNT_ID=
# The Facebook Page the ads run as (Page → About → Page ID)
META_PAGE_ID=
# Optional: Pixel/Dataset id, required only for the "sales" objective
META_PIXEL_ID=
# Graph API version; check developers.facebook.com/docs/graph-api/changelog
META_API_VERSION=v23.0

# --- TikTok API for Business ---------------------------------------------------
# Leave TIKTOK_ACCESS_TOKEN empty to keep using the mock TikTok adapter.
# Long-lived token from the TikTok for Business developer app (scopes: Ads Management, Reporting)
TIKTOK_ACCESS_TOKEN=
# Advertiser id shown in TikTok Ads Manager (digits)
TIKTOK_ADVERTISER_ID=
# Optional: defaults to https://business-api.tiktok.com/open_api/v1.3
TIKTOK_API_BASE=

# --- Google Ads API ------------------------------------------------------------
# Leave GOOGLE_ADS_DEVELOPER_TOKEN empty to keep using the mock Google Ads adapter.
# Google Ads → Tools → API Center → Developer token (needs Basic access for real accounts)
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth client (Google Cloud Console → Credentials) and a refresh token with the adwords scope
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Ad account to manage, 10 digits with or without dashes (e.g. 123-456-7890)
GOOGLE_ADS_CUSTOMER_ID=
# Optional: manager (MCC) account id when access goes through a manager account
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional: API version, defaults to v21; check developers.google.com/google-ads/api/docs/release-notes
GOOGLE_ADS_API_VERSION=
